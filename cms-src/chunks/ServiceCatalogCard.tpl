<article class="catalog-service grid" id="service-[+id+]">
  <div class="catalog-service-media"><div class="catalog-service-photo">[+card_cover_html+]<span class="data step catalog-service-number">[+card_number+]<i aria-hidden="true"></i></span></div></div>
  <div class="catalog-service-title"><h2 class="heading service-title">[+card_pagetitle+]</h2><p class="label caps">[+card_longtitle+]</p></div>
  <div class="catalog-service-description flex flex-column justify-between align-start">
    <p class="body service-description">[+card_description+]</p>
    <button class="button button-inverse label button-caption-sm catalog-more" type="button" disabled><span class="button-text">Подробнее</span><span class="button-icon"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span></button>
  </div>
</article>
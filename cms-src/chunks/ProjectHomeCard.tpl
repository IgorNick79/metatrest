<article class="project-card flex flex-column justify-between">
  [+card_image_html+]
  <header class="project-top flex">
    <div class="project-title flex align-center flex-grow"><h3 class="heading project">[+card_pagetitle+]</h3></div>
    [+project_years+]
  </header>
  <div class="project-bottom flex align-center">
    <p class="body caption flex-grow"><span class="project-caption-text">[+card_description+]</span></p>
    <span class="project-arrow flex align-center justify-center"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span>
  </div>
</article>
<article class="catalog-project grid" id="project-[+id+]">
  <div class="catalog-project-info flex flex-column justify-between align-start">
    <div class="catalog-project-content">
      <h2 class="heading project">[+card_pagetitle+]</h2>
      <ul class="project-meta body project-detail flex flex-column">[+project_metadata+]</ul>
      <ul class="project-tags flex label tag">[+project_tags_html+]</ul>
    </div>
    <button class="button button-inverse label [+project_button_class+]" type="button" disabled><span class="button-text">Подробнее</span><span class="button-icon"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span></button>
  </div>
  <div class="catalog-project-photos grid" tabindex="0" role="group" aria-label="Фотографии проекта">[+project_photos+]</div>
</article>
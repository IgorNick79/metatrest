<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  [!DocLister? &documents=`[*id*]` &idType=`documents` &tvList=`meta_title,meta_description,meta_robots` &tpl=`@FILE:metatrest/seo-head` !]
  <link rel="stylesheet" href="/assets/css/global.css">
  <link rel="stylesheet" href="/assets/css/adaptives.css">
  <link rel="stylesheet" href="/assets/css/mobile.css">
  <script src="/assets/js/main.js" defer></script>
</head>
<body class="home-page frontend-page">
  {{Header}}

  
  <main>
    <section class="hero-screen" aria-labelledby="hero-title">
      <div class="hero-media wrap" aria-hidden="true">
        <img class="cover" src="/assets/img/hero.png" alt="">
      </div>
      <div class="hero-panel flex flex-column">
        <div class="hero-copy flex flex-column">
          <h1 class="display hero" id="hero-title">[!DocLister? &documents=`[*id*]` &idType=`documents` &tvList=`meta_title,meta_description,meta_robots` &tpl=`@FILE:metatrest/seo-h1` !]</h1>
          <p class="body large">Строительная компания с собственной производственной базой в Москве <br>и Санкт-Петербурге. Работаем на объектах СЗФО <br class="mobile-break">с 2020 года.</p>
          <div class="hero-actions flex flex-wrap">
            <a class="button button-primary label button-caption-lg" href="[~2~]#request-title">
  <span class="button-text">Запросить расчёт</span>
  <span class="button-icon"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span>
</a>
            <span class="button button-outline label button-caption-lg" role="link" aria-disabled="true">
  <span class="button-text">Скачать наши проекты <svg class="icon pdf-badge" aria-hidden="true"><use href="/assets/svg/sprite.svg#pdf-badge"></use></svg></span>
  <span class="button-icon"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-download"></use></svg></span>
</span>
          </div>
        </div>
        <ul class="hero-stats flex justify-between nowrap">
          <li class="flex flex-column">
            <p class="data metric-l flex"><span class="metric-sign">&gt;</span>15 000 т</p>
            <p class="label caps">изготовлено и смонтировано</p>
          </li>
          <li class="flex flex-column">
            <p class="data metric-l flex"><span class="metric-sign">&gt;</span>471 000 ПМ</p>
            <p class="label caps">шпунтовых работ</p>
          </li>
          <li class="flex flex-column">
            <p class="data metric-l flex">6 лет<span class="metric-sign">+</span></p>
            <p class="label caps">работы в отрасли</p>
          </li>
        </ul>
      </div>
    </section>
    <section class="build-section wrap" aria-labelledby="build-title">
      <div class="section-heading flex align-end justify-between">
        <h2 class="heading section" id="build-title">Строим под ключ</h2>
        <a class="section-link label caps caps-link" href="#build-items"><span class="flex align-center"><b>Все объекты строительства</b><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#section-link"></use></svg></span></a>
      </div>
      <ul id="build-items" class="build-track flex" data-scroll-track tabindex="0" aria-label="Типы объектов">
        <li class="build-card build-warehouse grid">
          <div class="build-card-media">
            <img src="/assets/img/build-warehouse.png" alt="">
          </div>
          <div class="build-card-content flex flex-column">
            <div class="build-card-heading flex flex-column align-start flex-grow">
              <h3 class="heading card">Склады и<br>логистические комплексы</h3>
              <span class="build-tag label tag">Промышленные объекты</span>
            </div>
            <div class="build-card-footer flex align-center justify-between label button-caption">
              <span>Подробнее об объектах</span>
              <span class="build-card-arrow flex align-center justify-center"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span>
            </div>
          </div>
        </li>
        <li class="build-card build-retail grid">
          <div class="build-card-media">
            <img src="/assets/img/build-retail.png" alt="">
          </div>
          <div class="build-card-content flex flex-column">
            <div class="build-card-heading flex flex-column align-start flex-grow">
              <h3 class="heading card">Торговые<br>и коммерческие объекты</h3>
              <span class="build-tag label tag">Коммерческие объекты</span>
            </div>
            <div class="build-card-footer flex align-center justify-between label button-caption">
              <span>Подробнее об объектах</span>
              <span class="build-card-arrow flex align-center justify-center"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span>
            </div>
          </div>
        </li>
        <li class="build-card build-sports grid">
          <div class="build-card-media">
            <img src="/assets/img/build-sports.png" alt="">
          </div>
          <div class="build-card-content flex flex-column">
            <div class="build-card-heading flex flex-column align-start flex-grow">
              <h3 class="heading card">Фитнес-залы и<br>спортивные объекты</h3>
              <span class="build-tag label tag">Коммерческие объекты</span>
            </div>
            <div class="build-card-footer flex align-center justify-between label button-caption">
              <span>Подробнее об объектах</span>
              <span class="build-card-arrow flex align-center justify-center"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span>
            </div>
          </div>
        </li>
        <li class="build-card build-industrial grid">
          <div class="build-card-media">
            <img src="/assets/img/build-industrial.png" alt="">
          </div>
          <div class="build-card-content flex flex-column">
            <div class="build-card-heading flex flex-column align-start flex-grow">
              <h3 class="heading card">Культурные<br>пространства</h3>
              <span class="build-tag label tag">Коммерческие объекты</span>
            </div>
            <div class="build-card-footer flex align-center justify-between label button-caption">
              <span>Подробнее об объектах</span>
              <span class="build-card-arrow flex align-center justify-center"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span>
            </div>
          </div>
        </li>
        <li class="build-card build-public grid">
          <div class="build-card-media">
            <img src="/assets/img/build-public.png" alt="">
          </div>
          <div class="build-card-content flex flex-column">
            <div class="build-card-heading flex flex-column align-start flex-grow">
              <h3 class="heading card">Выставочные<br>центры</h3>
              <span class="build-tag label tag">Коммерческие объекты</span>
            </div>
            <div class="build-card-footer flex align-center justify-between label button-caption">
              <span>Подробнее об объектах</span>
              <span class="build-card-arrow flex align-center justify-center"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span>
            </div>
          </div>
        </li>
      </ul>
      <div class="build-scroll" hidden><input type="range" min="0" max="1000" value="0" aria-label="Прокрутка типов объектов"></div>
    </section>
    <section class="services-section wrap" aria-labelledby="services-title">
      <div class="section-heading flex align-end justify-between">
        <h2 class="heading section" id="services-title">Наши услуги</h2>
        <a class="section-link label caps caps-link" href="[~3~]"><span class="flex align-center"><b>Все услуги</b><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#section-link"></use></svg></span></a>
      </div>
      <div class="services-grid grid" data-services>
        <ol id="services-items" class="services-list grid">
[!DocLister? &parents=`3` &depth=`1` &orderBy=`c.menuindex ASC,c.id ASC` &showNoPublish=`0` &display=`7` &tvList=`card_image` &prepare=`MetaTrestCardData` &tpl=`ServiceHomeItem` !]
</ol>
        [!DocLister? &parents=`3` &depth=`1` &orderBy=`c.menuindex ASC,c.id ASC` &showNoPublish=`0` &display=`1` &tvList=`card_image` &prepare=`MetaTrestCardData` &tpl=`ServiceHomePreview` !]
      </div>
    </section>
    <section class="projects-section wrap" aria-labelledby="projects-title">
      <div class="section-heading flex align-end justify-between">
        <h2 class="heading section" id="projects-title">Другие наши проекты</h2>
        <a class="section-link label caps caps-link" href="[~2~]"><span class="flex align-center"><b>Все проекты</b><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#section-link"></use></svg></span></a>
      </div>
      <div id="projects-items" class="projects-grid grid" data-scroll-track tabindex="0" role="group" aria-label="Проекты">
[!DocLister? &parents=`2` &depth=`1` &orderBy=`c.menuindex ASC,c.id ASC` &showNoPublish=`0` &display=`3` &tvList=`card_image,project_gallery,project_location,project_customer,project_period,project_tags` &prepare=`MetaTrestCardData` &tpl=`ProjectHomeCard` !]
</div>
    </section>
    <section class="partners-section wrap" aria-labelledby="partners-title">
      <div class="section-heading flex align-end">
        <h2 class="heading section" id="partners-title">Партнёры и клиенты</h2>
      </div>
      <div class="partners-panel flex flex-column align-center justify-center" role="group" aria-label="НОВАТЭК">
        <div class="partners-row flex justify-center" aria-hidden="true">
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
        </div>
        <div class="partners-row flex justify-center" aria-hidden="true">
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
          <span class="partner-tile grid"><img src="/assets/img/partner-novatek.png" alt=""></span>
        </div>
      </div>
    </section>
    <section class="about-section wrap" aria-labelledby="about-title">
      <div class="section-heading flex align-end">
        <h2 class="heading section" id="about-title">О компании</h2>
      </div>
      <div class="about-grid grid">
        <div class="about-copy flex flex-column justify-between align-start">
          <div class="about-intro flex flex-column">
            <h3 class="heading lead">МетаТрест —<br>сила конструкции<br>в каждом этапе</h3>
            <p class="body medium">Работаем с 2020 года. Собственное производство и техника. Разрабатываем КМД, изготавливаем и монтируем — за счёт этого контролируем качество на каждом этапе.</p>
          </div>
          <button class="button button-inverse label button-caption-md" type="button" disabled>
            <span class="button-text">Узнать больше о нас</span>
            <span class="button-icon"><svg class="icon" aria-hidden="true"><use href="/assets/svg/sprite.svg#arrow-link"></use></svg></span>
          </button>
        </div>
        <div class="about-media" aria-hidden="true"></div>
        <ul class="about-stats grid">
          <li class="flex flex-column justify-between">
            <p class="data metric">6 лет</p>
            <p class="body medium stat-caption">работаем на рынке</p>
          </li>
          <li class="flex flex-column justify-between">
            <p class="data metric">50k<span class="mobile-stat-sign">+</span></p>
            <p class="body medium stat-caption">производственных площадей</p>
          </li>
          <li class="flex flex-column justify-between">
            <p class="data metric">120<span class="mobile-stat-sign">+</span></p>
            <p class="body medium stat-caption">партнёров и клиентов в Санкт-Петербурге, ЛО и Москве</p>
          </li>
        </ul>
      </div>
    </section>
  </main>
  {{Footer}}
</body>
</html>
